{
  "name": "agents-of-the-dawm-floodline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agents of the Dawm: Floodline — original browser gravity rescue vertical slice",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:sim": "vitest run tests/sim",
    "test:render": "vitest run tests/render",
    "test:world": "vitest run tests/world",
    "test:ui": "vitest run tests/ui",
    "test:audio": "vitest run tests/audio",
    "test:e2e": "playwright test",
    "audit:assets": "node scripts/audit-assets.mjs",
    "bench:frame": "node scripts/bench-frame.mjs",
    "build:wasm": "bash scripts/build-worldgraph-wasm.sh",
    "test:app": "vitest run tests/app"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
